[Match]
MACAddress={{ lan_mac_address }}
Type=!vlan

[Network]
{% if vlans is defined %}
{% for vlan in vlans %}
VLAN=lan.{{ vlan.name }}
{% endfor %}
{% endif %}
{%if ipv6 is defined%}

{%if ipv6.lan_prefix is defined or (ipv6.prefix_delegation | default(false)) %}
IPv6SendRA=true
{%endif%}
{%if ipv6.prefix_delegation | default(false)%}
DHCPPrefixDelegation=true
{%endif%}

{%if ipv6.prefix_delegation | default(false)%}

[DHCPPrefixDelegation]
UplinkInterface=ppp0
SubnetId={{ ipv6.lan_subnet_id }}
{%endif%}

{%if ipv6.lan_prefix is defined or (ipv6.prefix_delegation | default(false)) %}
[IPv6Prefix]
Prefix={{ ipv6.lan_prefix}}
Assign=true
{%endif%}
{%endif%}

[Address]
Address=10.1.1.{{ ip_suffix }}/24
